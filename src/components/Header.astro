---
import { UI } from '../i18n/ui';
import T from './T.astro';
---

<header class="site-header">
  <a class="brand" href="#top">Marvin Mai</a>
  <nav class="nav" id="nav" aria-label={UI.nav.label.en}>
    <a href="#experience"><T t={UI.nav.experience} /></a>
    <a href="#how"><T t={UI.nav.how} /></a>
    <a href="#contact"><T t={UI.nav.contact} /></a>
  </nav>
  <div class="tools">
    <div class="toggle" role="group" id="lang-group" aria-label={UI.lang.label.en}>
      <button type="button" data-set-lang="de" aria-pressed="false" aria-label="Deutsch">DE</button>
      <button type="button" data-set-lang="en" aria-pressed="true" aria-label="English">EN</button>
    </div>
    <div class="toggle culture-ctl" role="group" id="culture-ctl" aria-label={UI.culture.label.en}>
      <button type="button" data-set-culture="professional" aria-pressed="true"><T t={UI.culture.formal} /></button>
      <button type="button" data-set-culture="personal" aria-pressed="false"><T t={UI.culture.casual} /></button>
    </div>
    <div class="toggle scheme-ctl" role="group" id="scheme-ctl" aria-label={UI.scheme.label.en}>
      <button type="button" data-set-scheme="light" aria-pressed="false"
        ><T t={UI.scheme.day} /><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"
          ><circle cx="8" cy="8" r="3"></circle><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1"></path></svg
        ></button
      >
      <button type="button" data-set-scheme="dark" aria-pressed="false"
        ><T t={UI.scheme.night} /><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"
          ><path d="M13.6 10.1A6 6 0 0 1 5.9 2.4a6 6 0 1 0 7.7 7.7z"></path></svg
        ></button
      >
    </div>
    <button type="button" id="open-palette" aria-haspopup="dialog" aria-label={UI.palette.open.en} title={UI.palette.title.en}
      ><kbd id="kbd-hint">Ctrl K</kbd><svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"
        ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg
      ></button
    >
  </div>
</header>
