---
import Clearing from '../components/Clearing.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowIWork from '../components/HowIWork.astro';
import Palette from '../components/Palette.astro';
import { UI } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---

<Base
  title="Marvin Mai"
  description="Marvin Mai, software engineer: Kotlin, Java, Spring. Backend systems with many interfaces, built test-first, with an eye for detail and code that is easy to read."
>
  <a class="skip" href="#main"><T t={UI.skip} /></a>
  <div class="light" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <Header />
  <main id="main" tabindex="-1">
    <span id="top"></span>
    <Hero />
    <Experience />
    <Clearing />
    <HowIWork />
    <Contact />
  </main>
  <Palette />
  <script>
    import '../scripts/site';
  </script>
</Base>
